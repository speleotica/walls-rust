            },
            "option": {
              "type": "string",
              "const": "GridNorthCorrection"
            }
          },
          "additionalProperties": false,
          "required": ["option", "correction"]
        },
        {
          "type": "object",
          "properties": {
            "correction": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "RectilinearNorthCorrection"
            }
          },
          "additionalProperties": false,
          "required": ["option", "correction"]
