            "correction": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "FrontsightAzimuthCorrection"
            }
          },
          "additionalProperties": false,
          "required": ["option", "correction"]
        },
        {
          "type": "object",
          "properties": {
            "correction": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "BacksightAzimuthCorrection"
            }
          },
          "additionalProperties": false,
          "required": ["option", "correction"]
        },
        {
          "type": "object",
          "properties": {
            "correction": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "FrontsightInclinationCorrection"
            }
          },
          "additionalProperties": false,
          "required": ["option", "correction"]
        },
        {
          "type": "object",
          "properties": {
            "correction": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "BacksightInclinationCorrection"
