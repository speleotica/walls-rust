{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WallsSrvFile",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SrvItem"
      }
    }
  },
  "additionalProperties": false,
  "required": ["items"],
  "$defs": {
    "Angle": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/AngleUnit"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["value", "unit"]
    },
    "AngleUnit": {
      "type": "string",
      "enum": ["Degrees", "Mils", "Grads"]
    },
    "Color": {
      "type": "object",
      "properties": {
        "b": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["r", "g", "b"]
    },
    "Comment": {
      "type": "object",
      "properties": {
        "comment": {
          "type": "string"
        },
        "inline": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "Comment"
        }
      },
      "additionalProperties": false,
      "required": ["type", "comment", "inline"]
    },
    "CompassAndTapeItem": {
      "type": "string",
      "enum": ["Distance", "Azimuth", "Inclination"]
    },
    "DateDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "day": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "month": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "DateDirective"
        },
        "year": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["type", "year", "month", "day"]
    },
    "FixDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "horizontal_variance": {
          "$ref": "#/$defs/VarianceAssignment"
        },
        "location": {
          "$ref": "#/$defs/FixLocation"
        },
        "note": {
          "type": ["string", "null"]
        },
        "segment": {
          "type": ["string", "null"]
        },
        "station": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "FixDirective"
        },
        "vertical_variance": {
          "$ref": "#/$defs/VarianceAssignment"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "station",
        "location",
        "horizontal_variance",
        "vertical_variance"
      ]
    },
    "FixLocation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "LatLong": {
              "type": "object",
              "properties": {
                "elevation": {
                  "$ref": "#/$defs/Length"
                },
                "latitude": {
                  "$ref": "#/$defs/Angle"
                },
                "longitude": {
                  "$ref": "#/$defs/Angle"
                }
              },
              "additionalProperties": false,
              "required": ["latitude", "longitude", "elevation"]
            }
          },
          "additionalProperties": false,
          "required": ["LatLong"]
        },
        {
          "type": "object",
          "properties": {
            "Grid": {
              "type": "object",
              "properties": {
                "easting": {
                  "$ref": "#/$defs/Length"
                },
                "elevation": {
                  "$ref": "#/$defs/Length"
                },
                "northing": {
                  "$ref": "#/$defs/Length"
                }
              },
              "additionalProperties": false,
              "required": ["easting", "northing", "elevation"]
            }
          },
          "additionalProperties": false,
          "required": ["Grid"]
        }
      ]
    },
    "FlagDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "flag": {
          "type": "string"
        },
        "stations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "const": "FlagDirective"
        }
      },
      "additionalProperties": false,
      "required": ["type", "stations", "flag"]
    },
    "Inclination": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/InclinationUnit"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["value", "unit"]
    },
    "InclinationUnit": {
      "type": "string",
      "enum": ["Degrees", "Mils", "Grads", "Percent"]
    },
    "Length": {
      "type": "object",
      "properties": {
        "unit": {
          "$ref": "#/$defs/LengthUnit"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": ["value", "unit"]
    },
    "LengthUnit": {
      "type": "string",
      "enum": ["Meters", "Feet", "Inches"]
    },
    "LrudStyle": {
      "type": "string",
      "enum": [
        "FromStationPerpendicular",
        "ToStationPerpendicular",
        "FromStationBisector",
        "ToStationBisector"
      ]
    },
    "NoteDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "note": {
          "type": "string"
        },
        "station": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "NoteDirective"
        }
      },
      "additionalProperties": false,
      "required": ["type", "station", "note"]
    },
    "PrefixDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "level": {
          "$ref": "#/$defs/PrefixLevel"
        },
        "prefix": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "const": "PrefixDirective"
        }
      },
      "additionalProperties": false,
      "required": ["type", "level"]
    },
    "PrefixLevel": {
      "type": "string",
      "enum": ["Prefix1", "Prefix2", "Prefix3"]
    },
    "RectilinearItem": {
      "type": "string",
      "enum": ["Easting", "Northing", "Elevation"]
    },
    "SegmentDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "segment": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "SegmentDirective"
        }
      },
      "additionalProperties": false,
      "required": ["type", "segment"]
    },
    "Shot": {
      "type": "object",
      "properties": {
        "c_flag": {
          "type": "boolean"
        },
        "comment": {
          "type": ["string", "null"]
        },
        "down": {
          "anyOf": [
            {
              "$ref": "#/$defs/Length"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "type": ["string", "null"]
        },
        "horizontal_variance": {
          "anyOf": [
            {
              "$ref": "#/$defs/VarianceAssignment"
            },
            {
              "type": "null"
            }
          ]
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/Length"
            },
            {
              "type": "null"
            }
          ]
        },
        "left_azimuth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Angle"
            },
            {
              "type": "null"
            }
          ]
        },
        "lrud_facing_azimuth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Angle"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurements": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotMeasurements"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/Length"
            },
            {
              "type": "null"
            }
          ]
        },
        "right_azimuth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Angle"
            },
            {
              "type": "null"
            }
          ]
        },
        "segment": {
          "type": ["string", "null"]
        },
        "to": {
          "type": ["string", "null"]
        },
        "type": {
          "type": "string",
          "const": "Shot"
        },
        "up": {
          "anyOf": [
            {
              "$ref": "#/$defs/Length"
            },
            {
              "type": "null"
            }
          ]
        },
        "vertical_variance": {
          "anyOf": [
            {
              "$ref": "#/$defs/VarianceAssignment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["type", "c_flag"]
    },
    "ShotMeasurements": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "backsight_azimuth": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Angle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "backsight_inclination": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Inclination"
                },
                {
                  "type": "null"
                }
              ]
            },
            "distance": {
              "$ref": "#/$defs/Length"
            },
            "frontsight_azimuth": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Angle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "frontsight_inclination": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Inclination"
                },
                {
                  "type": "null"
                }
              ]
            },
            "instrument_height": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_height": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "CompassAndTape"
            }
          },
          "additionalProperties": false,
          "required": ["type", "distance"]
        },
        {
          "type": "object",
          "properties": {
            "easting": {
              "$ref": "#/$defs/Length"
            },
            "elevation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Length"
                },
                {
                  "type": "null"
                }
              ]
            },
            "northing": {
              "$ref": "#/$defs/Length"
            },
            "type": {
              "type": "string",
              "const": "Rectilinear"
            }
          },
          "additionalProperties": false,
          "required": ["type", "easting", "northing"]
        }
      ]
    },
    "SrvItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnitsDirective"
        },
        {
          "$ref": "#/$defs/SegmentDirective"
        },
        {
          "$ref": "#/$defs/FixDirective"
        },
        {
          "$ref": "#/$defs/PrefixDirective"
        },
        {
          "$ref": "#/$defs/NoteDirective"
        },
        {
          "$ref": "#/$defs/FlagDirective"
        },
        {
          "$ref": "#/$defs/SymbolDirective"
        },
        {
          "$ref": "#/$defs/DateDirective"
        },
        {
          "$ref": "#/$defs/Shot"
        },
        {
          "$ref": "#/$defs/Comment"
        }
      ]
    },
    "StationNameCaseConversion": {
      "type": "string",
      "enum": ["Upper", "Lower", "Mixed"]
    },
    "SymbolDirective": {
      "type": "object",
      "properties": {
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "type": "null"
            }
          ]
        },
        "comment": {
          "type": ["string", "null"]
        },
        "flag": {
          "type": ["string", "null"]
        },
        "opacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolOpacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "point_size": {
          "type": ["integer", "null"],
          "format": "uint32",
          "minimum": 0
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolShape"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "SymbolDirective"
        }
      },
      "additionalProperties": false,
      "required": ["type"]
    },
    "SymbolOpacity": {
      "type": "string",
      "enum": ["Solid", "Opaque", "Clear", "Transparent"]
    },
    "SymbolShape": {
      "type": "string",
      "enum": ["Square", "Circle", "Triangle", "PlusSign"]
    },
    "TapingMethod": {
      "type": "string",
      "enum": [
        "InstrumentToTarget",
        "StationToStation",
        "InstrumentToStation",
        "StationToTarget"
      ]
    },
    "UnitsDirective": {
      "type": "object",
      "properties": {
        "comment": {
          "type": ["string", "null"]
        },
        "options": {
