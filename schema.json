          "properties": {
            "option": {
              "type": "string",
              "const": "Rectilinear"
            }
          },
          "additionalProperties": false,
          "required": ["option"]
        },
        {
          "type": "object",
          "properties": {
            "option": {
              "type": "string",
              "const": "CompassAndTapeOrder"
            },
            "order": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CompassAndTapeItem"
              }
            }
          },
          "additionalProperties": false,
          "required": ["option", "order"]
        },
        {
          "type": "object",
          "properties": {
            "option": {
              "type": "string",
              "const": "RectilinearOrder"
            },
            "order": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RectilinearItem"
              }
            }
          },
          "additionalProperties": false,
          "required": ["option", "order"]
