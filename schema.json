            },
            "unit": {
              "$ref": "#/$defs/InclinationUnit"
            }
          },
          "additionalProperties": false,
          "required": ["option", "unit"]
        },
        {
          "type": "object",
          "properties": {
            "option": {
              "type": "string",
              "const": "BacksightInclinationUnit"
            },
            "unit": {
              "$ref": "#/$defs/InclinationUnit"
            }
          },
          "additionalProperties": false,
          "required": ["option", "unit"]
        },
        {
          "type": "object",
          "properties": {
            "declination": {
              "$ref": "#/$defs/Angle"
            },
            "option": {
              "type": "string",
              "const": "MagneticDeclination"
            }
          },
          "additionalProperties": false,
          "required": ["option", "declination"]
        },
        {
          "type": "object",
          "properties": {
            "correction": {
